# ============================================
# PinatAuth Environment Configuration
# ============================================

APP_NAME=PinatAuth
APP_ENV=production
APP_KEY=base64:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
APP_DEBUG=false
APP_URL=http://localhost:5000

# ============================================
# DATABASE - PostgreSQL
# ============================================

DB_CONNECTION=pgsql
DB_HOST=host.docker.internal
DB_PORT=5432
DB_DATABASE=pinat_auth
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# ============================================
# SESSION
# ============================================

SESSION_DRIVER=database
SESSION_LIFETIME=120

# ============================================
# JWT CONFIGURATION
# ============================================

JWT_TTL=3600

# ============================================
# CACHE & QUEUE
# ============================================

CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# ============================================
# SETUP COMMANDS
# ============================================

# 1. Generate APP_KEY:
#    docker-compose run --rm pinat-auth php artisan key:generate --show

# 2. Build dan jalankan:
#    docker-compose up -d

# 3. Run migrations:
#    docker-compose exec pinat-auth php artisan migrate

# 4. Generate JWT keys:
#    docker-compose exec pinat-auth php artisan jwt:keys
